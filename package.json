{
	"name": "@absolutejs/rag-adapters",
	"private": true,
	"type": "module",
	"description": "Vector-store adapters for @absolutejs/rag (Pinecone, PostgreSQL/pgvector, SQLite)",
	"workspaces": [
		"pinecone",
		"postgres",
		"sqlite"
	],
	"scripts": {
		"build": "bun run --filter './*' build",
		"config": "absolute config",
		"format": "prettier --write \"./*/src/**/*.{ts,json,md}\"",
		"test": "bun run --filter './*' test",
		"typecheck": "bun run --filter './*' typecheck"
	},
	"devDependencies": {
		"@absolutejs/absolute": "^0.19.0-beta.1051",
		"prettier": "3.5.3"
	}
}
