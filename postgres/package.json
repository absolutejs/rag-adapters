{
  "name": "@absolutejs/rag-postgres",
  "version": "0.0.12",
  "description": "PostgreSQL (pgvector) vector-store adapter for @absolutejs/rag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/rag-adapters.git",
    "directory": "postgres"
  },
  "homepage": "https://github.com/absolutejs/rag-adapters/tree/main/postgres",
  "bugs": {
    "url": "https://github.com/absolutejs/rag-adapters/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "absolutejs",
    "rag",
    "postgresql",
    "pgvector",
    "vector"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --sourcemap --target=bun --external @absolutejs/rag --external @absolutejs/rag/adapter-kit --external @absolutejs/ai && tsc --project tsconfig.build.json && absolute-manifest emit",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "release": "bun run format && bun run build && bun publish"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.7.2",
    "@sinclair/typebox": "^0.34.0"
  },
  "peerDependencies": {
    "@absolutejs/rag": ">=0.1.0 <0.2.0"
  },
  "devDependencies": {
    "@absolutejs/ai": "0.0.47",
    "@absolutejs/rag": "0.1.1",
    "@absolutejs/sync": "2.11.0",
    "@types/bun": "1.3.14",
    "prettier": "3.5.3",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "absolutejs": {
    "manifestContract": 1,
    "runtimePeers": {
      "@absolutejs/rag": {
        "artifactImports": [
          "@absolutejs/rag/adapter-kit"
        ],
        "artifactReferences": [],
        "buildExternals": [
          "@absolutejs/rag",
          "@absolutejs/rag/adapter-kit"
        ],
        "optional": false,
        "range": ">=0.1.0 <0.2.0",
        "tested": "0.1.1"
      }
    }
  }
}
