{
	"name": "@absolutejs/rag-sqlite",
	"version": "0.0.7",
	"description": "SQLite vector-store adapter for @absolutejs/rag with optional native vec0 acceleration",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/rag-adapters.git",
		"directory": "sqlite"
	},
	"homepage": "https://github.com/absolutejs/rag-adapters/tree/main/sqlite",
	"bugs": {
		"url": "https://github.com/absolutejs/rag-adapters/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Alex Kahn",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"absolutejs",
		"rag",
		"sqlite",
		"vector",
		"sqlite-vec"
	],
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --sourcemap --target=bun --external @absolutejs/rag --external @absolutejs/rag/adapter-kit --external @absolutejs/ai && tsc --project tsconfig.build.json && absolute-manifest emit",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"./**/*.{ts,json,md}\"",
		"release": "bun run format && bun run build && bun publish"
	},
	"dependencies": {
		"@absolutejs/manifest": "^0.1.0",
		"@absolutejs/rag": "^0.0.20",
		"@sinclair/typebox": "^0.34.0"
	},
	"optionalDependencies": {
		"@absolutejs/absolute-rag-sqlite-darwin-arm64": "0.0.2",
		"@absolutejs/absolute-rag-sqlite-darwin-x64": "0.0.2",
		"@absolutejs/absolute-rag-sqlite-linux-arm64": "0.0.2",
		"@absolutejs/absolute-rag-sqlite-linux-x64": "0.0.2",
		"@absolutejs/absolute-rag-sqlite-windows-x64": "0.0.2"
	},
	"devDependencies": {
		"@absolutejs/ai": "^0.0.9",
		"@types/bun": "1.3.9",
		"prettier": "3.5.3",
		"typescript": "5.8.3"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"import": "./dist/manifest.js",
			"default": "./dist/manifest.js"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"absolutejs": {
		"manifestContract": 1
	}
}
